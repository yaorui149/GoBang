<Window x:Class="GoBang.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:GoBang.View"
        Title="五子棋" Width="900" Height="800" MinWidth="760" MinHeight="620"
        Background="#212226" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#33363B"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40454B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D31"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SideCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8CDD4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#26282C" BorderBrush="#35383D" BorderThickness="1"
                                CornerRadius="6" Padding="8,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303338"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33415C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B8DEF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26282C" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="模式" Foreground="#8A8F98" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="PvpRadio" Content="双人对弈" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="PveRadio" Content="人机对弈" Margin="18,0,0,0" Checked="Mode_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重新开局" Click="Restart_Click"/>
                    <Button Content="悔棋" Click="Undo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#26282C" Padding="14,9">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="TurnDot" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="#E8E8E8" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="MoveText" Foreground="#8A8F98" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <view:BoardView x:Name="BoardView" Grid.Column="0" Margin="10"/>

            <Border Grid.Column="1" Background="#1B1C1F" BorderBrush="#2C2E33" BorderThickness="1"
                    CornerRadius="8" Margin="0,10,10,10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="执子" Foreground="#8A8F98" FontSize="12" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="BlackSideRadio" Style="{StaticResource SideCardStyle}"
                                         Content="● 黑棋" GroupName="HumanSide" IsChecked="True"
                                         Margin="0,0,4,0" Checked="HumanSide_Checked"/>
                            <RadioButton x:Name="WhiteSideRadio" Style="{StaticResource SideCardStyle}"
                                         Content="○ 白棋" GroupName="HumanSide"
                                         Margin="4,0,0,0" Checked="HumanSide_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="SideHintText" Foreground="#7E848D" FontSize="11"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <Border Height="1" Background="#2C2E33" Margin="0,12,0,10"/>
                        <TextBlock Text="AI" Foreground="#8A8F98" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AiStatusText" Foreground="#9AA0A8" FontSize="11"
                                   TextWrapping="Wrap" Text="AI：启发式（尚未训练）"/>
                        <Button x:Name="TrainButton" Content="训练 AI" Margin="0,8,0,0" Click="Train_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="对局记录" Foreground="#8A8F98" FontSize="12"
                               Margin="0,10,0,6"/>

                    <ScrollViewer x:Name="LogScroll" Grid.Row="3" Background="#15161A" Padding="6"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                                   Foreground="#B9BEC6" LineHeight="18"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
